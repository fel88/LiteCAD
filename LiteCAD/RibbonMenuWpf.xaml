<UserControl
    x:Class="LiteCAD.RibbonMenuWpf"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LiteCAD"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Ribbon x:Name="RibbonWin" SelectedIndex="0">
            <Ribbon.HelpPaneContent>
                <RibbonButton
                    x:Name="HelpButton"
                    Click="HelpButton_Click"
                    SmallImageSource="Icons\question.png" />
            </Ribbon.HelpPaneContent>
            <Ribbon.ApplicationMenu>
                <RibbonApplicationMenu Visibility="Collapsed" />
            </Ribbon.ApplicationMenu>
            <Ribbon.QuickAccessToolBar>
                <RibbonQuickAccessToolBar Visibility="Collapsed" />
            </Ribbon.QuickAccessToolBar>
            <RibbonTab
                x:Name="projectTab"
                Header="Project"
                KeyTip="H">
                <!--  Home  group  -->
                <RibbonGroup x:Name="General" Header="General">
                    <RibbonToggleButton
                        Click="RibbonButton_Click_1"
                        KeyTip="X"
                        Label="Selection"
                        SmallImageSource="Icons/cursor.ico" />
                    <RibbonButton
                        Click="RibbonButton_Click_2"
                        KeyTip="F"
                        Label="Fit all"
                        SmallImageSource="Icons/magnifier.ico" />
                    <RibbonButton
                        Click="RibbonButton_Click_12"
                        Label="Undo"
                        SmallImageSource="Icons/arrow-curve-180-left.ico" />



                    <!--<RibbonMenuButton  Label="Employee" KeyTip="V">
                        <RibbonMenuItem  Header="Keep Text Only" KeyTip="T"/>
                        <RibbonMenuItem Header="Paste Special..." KeyTip="S"/>
                    </RibbonMenuButton>
                    <RibbonButton  Label="Save" KeyTip="X" />
                    <RibbonButton  Label="Add" KeyTip="C" />-->
                </RibbonGroup>
                <RibbonGroup x:Name="FileGroup" Header="File">
                    <RibbonButton
                        Click="RibbonButton_Click_11"
                        KeyTip="C"
                        Label="New"
                        SmallImageSource="Icons/blue-document.png" />
                    <RibbonButton
                        Click="RibbonButton_Click"
                        KeyTip="C"
                        Label="Open"
                        SmallImageSource="Icons/folder-horizontal-open.png" />
                    <RibbonButton
                        Click="RibbonButton_Click_4"
                        KeyTip="X"
                        Label="Save as"
                        SmallImageSource="Icons/disk.ico" />
                    <RibbonMenuButton
                        KeyTip="V"
                        Label="Export as"
                        SmallImageSource="Icons/blue-document-export.png">
                        <RibbonMenuItem Header="Step" KeyTip="T" />
                    </RibbonMenuButton>
                    <!--<RibbonButton  Label="Format Painter" KeyTip="FP" />-->
                </RibbonGroup>
                <!--  Employee And Payroll group  -->


                <RibbonGroup x:Name="operators" Header="Operators ">
                    <RibbonButton
                        Click="RibbonButton_Click_3"
                        KeyTip="X"
                        Label="Extrude"
                        SmallImageSource="Icons/fill-090.png" />
                    <RibbonToggleButton
                        x:Name="adjointButton"
                        Click="adjointButton_Click"
                        KeyTip="X"
                        Label="Snap"
                        SmallImageSource="Icons/magnet.ico" />
                    <RibbonButton
                        Click="RibbonButton_Click_13"
                        KeyTip="M"
                        Label="Merge"
                        SmallImageSource="Icons/plug-connect.png" />
                </RibbonGroup>
                <RibbonGroup x:Name="camera" Header="Camera ">
                    <RibbonButton
                        Click="RibbonButton_Click_6"
                        KeyTip="X"
                        Label="X view" />
                    <RibbonButton
                        Click="RibbonButton_Click_7"
                        KeyTip="X"
                        Label="Y view" />
                    <RibbonButton
                        Click="RibbonButton_Click_8"
                        KeyTip="X"
                        Label="Z view" />
                    <RibbonButton
                        Click="RibbonButton_Click_5"
                        KeyTip="X"
                        Label="Reset camera" />

                    <RibbonMenuButton Label="Switch">
                        <RibbonButton
                            Click="RibbonButton_Click_9"
                            KeyTip="X"
                            Label="Switch up" />
                        <RibbonButton
                            Click="RibbonButton_Click_10"
                            KeyTip="X"
                            Label="Switch from" />
                    </RibbonMenuButton>
                    <RibbonToggleButton
                        x:Name="showNormalsToggle"
                        Click="RibbonToggleButton_Click"
                        KeyTip="X"
                        Label="Show normals" />
                </RibbonGroup>
                <RibbonGroup x:Name="settings" Header="Settings ">
                    <RibbonButton Label="Settings" SmallImageSource="Icons/gear.png" />
                </RibbonGroup>
                <RibbonGroup x:Name="blueprint" Header="PCB ">
                    <RibbonButton
                        x:Name="scheme"
                        KeyTip="I"
                        Label="Scheme" />
                    <RibbonButton
                        x:Name="board"
                        KeyTip="I"
                        Label="Board" />
                    <RibbonButton
                        x:Name="export"
                        KeyTip="I"
                        Label="Export" />
                </RibbonGroup>
            </RibbonTab>


            <!--  Ribbon Tab #2:  -->
            <RibbonTab
                x:Name="draftTab"
                Header="Draft"
                IsEnabled="false"
                KeyTip="I">
                <RibbonGroup x:Name="general" Header="General ">
                    <RibbonButton
                        x:Name="undo"
                        Click="undo_Click"
                        KeyTip="X"
                        Label="Undo"
                        SmallImageSource="Icons/arrow-curve-180-left.ico" />
                    <RibbonButton
                        x:Name="fitAll"
                        Click="RibbonButton_Click_2"
                        KeyTip="F"
                        Label="Fit all"
                        SmallImageSource="Icons/magnifier.ico" />

                </RibbonGroup>
                <RibbonGroup x:Name="constr" Header="Constraints ">
                    <RibbonButton
                        x:Name="linearConstrBtn"
                        Click="linearConstrBtn_Click"
                        KeyTip="X"
                        Label="Size"
                        SmallImageSource="Icons/arrow-resize.ico" />
                    <RibbonButton
                        x:Name="vertConstrBtn"
                        Click="vertConstrBtn_Click"
                        KeyTip="X"
                        Label="Vertical" />
                    <RibbonButton
                        x:Name="horConstrBtn"
                        Click="horConstrBtn_Click"
                        KeyTip="X"
                        Label="Horizontal" />
                    <RibbonButton
                        x:Name="parallelConstr"
                        KeyTip="X"
                        Label="Parallel" />
                    <RibbonButton
                        x:Name="equalConstr"
                        Click="equalConstr_Click"
                        KeyTip="X"
                        Label="Equal" />
                    <RibbonButton
                        x:Name="ponitAnchor"
                        Click="ponitAnchor_Click"
                        KeyTip="X"
                        Label="Point Anchor"
                        SmallImageSource="Icons/anchor.png" />
                    <RibbonButton
                        x:Name="topoConstr"
                        Click="topoConstr_Click"
                        KeyTip="X"
                        Label="Topology"
                        SmallImageSource="Icons/molecule.png" />

                </RibbonGroup>
                <RibbonGroup x:Name="solvers" Header="Solvers ">
                    <RibbonButton
                        x:Name="solveCsp"
                        Click="solveCsp_Click"
                        KeyTip="X"
                        Label="Solve"
                        SmallImageSource="Icons/puzzle.png" />
                    <RibbonButton
                        x:Name="randSolve"
                        Click="randSolve_Click"
                        KeyTip="X"
                        Label="Random Solve"
                        SmallImageSource="Icons/magnifier-zoom-actual-equal.png" />
                    <RibbonToggleButton
                        x:Name="autoSolve"
                        KeyTip="X"
                        Label="Auto solve" />

                </RibbonGroup>
                <RibbonGroup x:Name="drawing" Header="Drawing ">
                    <RibbonButton
                        x:Name="Selection"
                        Click="Selection_Click"
                        KeyTip="X"
                        Label="Selection"
                        SmallImageSource="Icons/cursor.ico" />
                    <RibbonButton
                        x:Name="Erase"
                        KeyTip="X"
                        Label="Erase"
                        SmallImageSource="Icons/eraser.ico" />
                    <RibbonButton
                        x:Name="Line"
                        Click="Line_Click"
                        KeyTip="X"
                        Label="Line"
                        SmallImageSource="Icons/layer-shape-line.ico" />
                    <RibbonButton
                        x:Name="CloseLine"
                        Click="CloseLine_Click"
                        KeyTip="X"
                        Label="Close Line"
                        SmallImageSource="Icons/layer-shape-polygon.png" />
                    <RibbonButton
                        x:Name="Rectangle"
                        Click="Rectangle_Click"
                        KeyTip="X"
                        Label="Rectangle"
                        SmallImageSource="Icons/layer-shape.ico" />
                    <RibbonButton
                        x:Name="Circle"
                        Click="Circle_Click"
                        KeyTip="X"
                        Label="Circle"
                        SmallImageSource="Icons/layer-shape-ellipse.ico" />
                    <RibbonButton
                        x:Name="Hex"
                        Click="Hex_Click"
                        KeyTip="H"
                        Label="Hex" />
                    <RibbonButton
                        x:Name="CutEdge"
                        Click="CutEdge_Click"
                        KeyTip="X"
                        Label="Cut edge"
                        SmallImageSource="Icons/cutter.png" />
                    <RibbonButton
                        x:Name="Merge"
                        KeyTip="X"
                        Label="Merge" />
                </RibbonGroup>
                <RibbonGroup x:Name="operts" Header="Operators ">
                    <RibbonButton
                        x:Name="flipV"
                        Click="flipV_Click"
                        KeyTip="X"
                        Label="Flip vertical"
                        SmallImageSource="Icons/layer-flip-vertical.png" />
                    <RibbonButton
                        x:Name="flipH"
                        Click="flipH_Click"
                        KeyTip="X"
                        Label="Flip horizontal"
                        SmallImageSource="Icons/layer-flip.png" />
                    <RibbonButton
                        x:Name="array"
                        Click="array_Click"
                        KeyTip="X"
                        Label="Array"
                        SmallImageSource="Icons/grid.png" />
                    <RibbonButton
                        x:Name="translate"
                        Click="translate_Click"
                        KeyTip="X"
                        Label="Translate" />
                    <RibbonButton
                        x:Name="offset"
                        Click="offset_Click"
                        KeyTip="X"
                        Label="Offset"
                        SmallImageSource="Icons/layer-resize.png" />

                </RibbonGroup>
                <RibbonGroup x:Name="helpers" Header="Helpers ">
                    <RibbonButton
                        x:Name="Image"
                        Click="Image_Click"
                        KeyTip="I"
                        Label="Image"
                        SmallImageSource="Icons/picture.png" />
                </RibbonGroup>
                <RibbonGroup x:Name="misc" Header="Misc ">

                    <RibbonButton
                        x:Name="Export"
                        Click="Export_Click"
                        KeyTip="X"
                        Label="Export"
                        SmallImageSource="Icons/blue-document-export.png" />
                    <RibbonButton
                        x:Name="Exit"
                        Click="Exit_Click"
                        KeyTip="X"
                        Label="Exit"
                        SmallImageSource="Icons/cross-button.ico" />
                    <RibbonToggleButton
                        x:Name="hVis"
                        Click="hVis_Click"
                        KeyTip="X"
                        Label="Helpers hide">
                        <RibbonToggleButton.Style>
                            <Style TargetType="{x:Type RibbonToggleButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsChecked}" Value="True">
                                        <Setter Property="SmallImageSource" Value="Icons/light-bulb-off.png" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsChecked}" Value="False">
                                        <Setter Property="SmallImageSource" Value="Icons/light-bulb.ico" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </RibbonToggleButton.Style>

                    </RibbonToggleButton>
                    <RibbonButton
                        x:Name="allSizesInline"
                        Click="allSizesInline_Click"
                        KeyTip="X"
                        Label="All sizes inline" />
                </RibbonGroup>
            </RibbonTab>
        </Ribbon>
    </Grid>
</UserControl>
